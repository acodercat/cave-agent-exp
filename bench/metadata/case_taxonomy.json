{
  "schema_version": 1,
  "task_families": {
    "table_delivery": {
      "label": "Table delivery",
      "definition": "Deliver a table of rows to the host; the size of the table is the controlled variable."
    },
    "calculation_reconciliation": {
      "label": "Calculation and reconciliation",
      "definition": "Calculate, weight, bridge scopes, or reconcile components and totals."
    },
    "comparison_ranking": {
      "label": "Comparison and ranking",
      "definition": "Compare entities, measures, or populations and identify ranks or extrema."
    },
    "risk_screening": {
      "label": "Risk, anomaly, and exposure screening",
      "definition": "Screen for risk, anomalous behavior, exposure, or economically material boundaries."
    },
    "scenario_analysis": {
      "label": "Scenario analysis",
      "definition": "Evaluate a sensitivity or outcome under explicitly pinned assumptions."
    },
    "temporal_path": {
      "label": "Temporal path and vintage",
      "definition": "Reason over ordered observations, event windows, vintages, or point-in-time cutoffs."
    }
  },
  "financial_domains": {
    "corporate_reporting": {
      "label": "Corporate reporting and transactions",
      "definition": "Company financial reporting, issuer disclosures, ownership transactions, and private capital events."
    },
    "banking_credit": {
      "label": "Banking and credit",
      "definition": "Depository institutions, regulatory capital, lending, credit performance, and debt-service conditions."
    },
    "investment_funds": {
      "label": "Investment funds",
      "definition": "Registered funds, money-market funds, business development companies, and portfolio holdings."
    },
    "capital_markets": {
      "label": "Capital markets and market structure",
      "definition": "Securities, trading, positioning, returns, market stress, pricing, and market microstructure."
    },
    "macro_rates_fx_trade": {
      "label": "Macro, rates, FX, and trade",
      "definition": "Macroeconomic vintages, interest rates, liquidity, exchange rates, and international trade."
    },
    "public_finance": {
      "label": "Public finance",
      "definition": "Government fiscal accounts, sovereign debt issuance, auctions, and public borrowing."
    },
    "household_housing": {
      "label": "Households and housing",
      "definition": "Household balance sheets, housing prices, and household-facing financial conditions."
    },
    "insurance_disaster": {
      "label": "Insurance and disaster exposure",
      "definition": "Insurance claims, disaster declarations, physical hazards, and geographically linked financial exposure."
    },
    "energy_commodities": {
      "label": "Energy and commodities",
      "definition": "Commodity prices, energy-market forecasts, and related realized price paths."
    }
  },
